{
  "name": "medmate-mobile-apps",
  "version": "0.1.0",
  "private": true,
  "description": "MedMate React Native monorepo. Apps share @medmate/theme and @medmate/base-components.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": "^20.19.4 || ^22.13.0 || ^24.3.0 || ^25.0.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "create-app": "tsx tools/workspace/bin.ts create-app",
    "bump:version": "tsx tools/workspace/bin.ts bump-version",
    "bump:build": "tsx tools/workspace/bin.ts bump-build",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "test": "nx run-many -t test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "quality": "nx run-many -t lint typecheck test && prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@nx/expo": "^22.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.14.0",
    "@types/react": "~19.2.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^16.2.7",
    "nx": "^22.0.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "ts-jest": "^29.4.5",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md,yml,yaml}": "prettier --write",
    "*.{ts,tsx,js,jsx}": "eslint --fix"
  }
}
