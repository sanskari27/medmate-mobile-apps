{
  "name": "theme",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/theme/src",
  "projectType": "library",
  "tags": ["type:ui", "scope:shared"],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "eslint packages/theme --max-warnings 0" },
      "cache": true
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "tsc -p packages/theme --noEmit" },
      "cache": true
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "jest --config packages/theme/jest.config.cjs --coverage" },
      "cache": true
    }
  }
}
